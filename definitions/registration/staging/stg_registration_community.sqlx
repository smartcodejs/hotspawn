config {
  type: "view",
  tags: ["registration", "staging", "community"]
}

WITH source_rows AS (

  SELECT
    id AS community_event_id,

    COALESCE(
      timestamp,
      original_timestamp,
      received_at
    ) AS registration_timestamp,

    NULLIF(TRIM(user_pseudo_id), '') AS source_user_pseudo_id

  FROM `hotspawn-440312.hotspawn_community_rudderstack.account_created`

  WHERE source = 'backend'
    AND event = 'account_created'
    AND (
      env = 'prod'
      OR env IS NULL
      OR TRIM(env) = ''
    )
)

SELECT

  TO_HEX(
    SHA256(
      CONCAT(
        'community_registration|',
        CAST(community_event_id AS STRING)
      )
    )
  ) AS registration_id,

  DATE(registration_timestamp) AS registration_date,

  registration_timestamp,

  'community_registration' AS registration_type,

  'community' AS source_system,

  'hotspawn_community_rudderstack.account_created' AS source_table,

  'account_created' AS source_event,

  CASE
    WHEN source_user_pseudo_id LIKE 'user-%'
      THEN NULL
    ELSE source_user_pseudo_id
  END AS user_pseudo_id,

  'success' AS registration_status,

  CAST(NULL AS STRING) AS source_signup_status,

  CAST(NULL AS STRING) AS signup_method,
  CAST(NULL AS STRING) AS signup_provider,

  CAST(NULL AS STRING) AS acquisition_channel,
  CAST(NULL AS STRING) AS acquisition_source,
  CAST(NULL AS STRING) AS country,
  CAST(NULL AS STRING) AS device_type,
  CAST(NULL AS INT64) AS total_sessions,

  CASE
    WHEN source_user_pseudo_id IS NULL THEN FALSE
    WHEN source_user_pseudo_id LIKE 'user-%' THEN FALSE
    ELSE TRUE
  END AS has_user_pseudo_id,

  TRUE AS is_valid_registration

FROM source_rows
