config {
  type: "view",
  tags: ["registration", "staging", "personal"],
  description: "Personal (Hotspawn site) registrations, one row per browser per day, from user_signup_schema (user_signup_event = 1). Excludes any browser + day that is a Pick'ems registration in stg_registration_pickems (decided from GA4), which fixes Pick'ems sign-ups mislabelled as personal by the form ID bug (49 in the TWC window, validated 2 Nov 2026)."
}

WITH source_rows AS (

  SELECT
    u.signup_date,
    u.user_pseudo_id,
    u.signup_status,
    u.signup_method,
    u.signup_provider,
    u.acquisition_channel,
    u.acquisition_source,
    u.country,
    u.device_type,
    u.total_sessions

  FROM ${ref("user_signup_schema")} u

  WHERE u.user_signup_event = 1

    -- A browser + day that is a Pick'ems registration is not also a personal registration.
    AND NOT EXISTS (
      SELECT 1
      FROM ${ref("stg_registration_pickems")} p
      WHERE p.registration_date = u.signup_date
        AND p.user_pseudo_id    = u.user_pseudo_id
    )
),

deduped AS (

  SELECT *
  FROM source_rows

  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY
      signup_date,
      user_pseudo_id

    ORDER BY
      CASE WHEN signup_status IS NOT NULL THEN 0 ELSE 1 END,
      CASE WHEN signup_method IS NOT NULL THEN 0 ELSE 1 END,
      CASE WHEN signup_provider IS NOT NULL THEN 0 ELSE 1 END,
      signup_method,
      signup_provider
  ) = 1
)

SELECT

  TO_HEX(
    SHA256(
      CONCAT(
        'personal_registration|',
        CAST(signup_date AS STRING),
        '|',
        COALESCE(user_pseudo_id, 'no_pseudo_id')
      )
    )
  ) AS registration_id,

  signup_date AS registration_date,

  CAST(NULL AS TIMESTAMP) AS registration_timestamp,

  'personal_registration' AS registration_type,

  'hotspawn' AS source_system,

  'analytics_457395054.user_signup_schema' AS source_table,

  'user_signup' AS source_event,

  user_pseudo_id,

  'success' AS registration_status,

  signup_status AS source_signup_status,

  signup_method,
  signup_provider,

  acquisition_channel,
  acquisition_source,
  country,
  device_type,
  total_sessions,

  user_pseudo_id IS NOT NULL AS has_user_pseudo_id,

  TRUE AS is_valid_registration

FROM deduped