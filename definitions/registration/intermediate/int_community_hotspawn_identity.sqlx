config {
  type: "view",
  tags: ["registration", "customerio", "identity", "community"]
}

WITH community_native AS (

  SELECT
    TO_HEX(
      SHA256(
        CONCAT(
          'community_registration|',
          CAST(id AS STRING)
        )
      )
    ) AS registration_id,

    LOWER(TRIM(email)) AS email

  FROM ${ref("account_created")}

  WHERE source = 'backend'
    AND event = 'account_created'
    AND (
      env = 'prod'
      OR env IS NULL
      OR TRIM(env) = ''
    )
    AND NULLIF(TRIM(email), '') IS NOT NULL
),

community AS (

  SELECT DISTINCT
    n.email

  FROM ${ref("fact_registrations")} f

  JOIN community_native n
    USING (registration_id)

  WHERE f.registration_type = 'community_registration'
),

identity_events AS (

  SELECT
    LOWER(
      TRIM(
        COALESCE(
          NULLIF(context_traits_email, ''),
          NULLIF(context_traits_user_email, '')
        )
      )
    ) AS email,

    pseudo_id,
    timestamp

  FROM `hotspawn-440312.website.identifies`,
  UNNEST([
    NULLIF(TRIM(context_traits_ga4_pseudo_id), ''),
    NULLIF(TRIM(context_traits_user_pseudo_id), ''),
    NULLIF(TRIM(context_traits_hs_ga4_pseudo_id), '')
  ]) AS pseudo_id

  WHERE pseudo_id IS NOT NULL
),

email_resolution AS (

  SELECT
    c.email,

    COUNT(DISTINCT i.pseudo_id) AS pseudo_id_count,

    CASE
      WHEN COUNT(DISTINCT i.pseudo_id) = 1
        THEN ANY_VALUE(i.pseudo_id)
      ELSE NULL
    END AS candidate_user_pseudo_id,

    MIN(i.timestamp) AS hotspawn_identity_first_seen,
    MAX(i.timestamp) AS hotspawn_identity_last_seen

  FROM community c

  LEFT JOIN identity_events i
    USING (email)

  GROUP BY c.email
),

pseudo_resolution AS (

  SELECT
    candidate_user_pseudo_id AS user_pseudo_id,
    COUNT(DISTINCT email) AS pseudo_email_count

  FROM email_resolution

  WHERE candidate_user_pseudo_id IS NOT NULL

  GROUP BY 1
)

SELECT
  e.email,

  CASE
    WHEN e.pseudo_id_count = 1
      AND p.pseudo_email_count = 1
    THEN e.candidate_user_pseudo_id
    ELSE NULL
  END AS user_pseudo_id,

  e.pseudo_id_count,

  COALESCE(p.pseudo_email_count, 0) AS pseudo_email_count,

  CASE
    WHEN e.pseudo_id_count = 0
      THEN 'COMMUNITY_ONLY'

    WHEN e.pseudo_id_count = 1
      AND p.pseudo_email_count = 1
      THEN 'COMMUNITY_HOTSPAWN_IDENTIFIED'

    ELSE 'AMBIGUOUS'
  END AS identity_status,

  e.hotspawn_identity_first_seen,
  e.hotspawn_identity_last_seen

FROM email_resolution e

LEFT JOIN pseudo_resolution p
  ON e.candidate_user_pseudo_id = p.user_pseudo_id
