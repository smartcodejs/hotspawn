config {
  type: "view",
  schema: "dataform",
  name: "int_registration_cio_eligibility",
  description: "Registration-level Customer.io identity eligibility. Canonical registration truth comes from fact_registrations. Community email comes from native Community account_created. Pickems email is enriched only when RudderStack identifies provides exactly one unambiguous email for the canonical GA4 pseudo ID. Registered-user activation requires email.",
  tags: ["registration"]
}

WITH canonical AS (

  SELECT
    registration_id,
    registration_date,
    registration_timestamp,
    registration_type,
    source_system,
    NULLIF(TRIM(user_pseudo_id), '') AS user_pseudo_id
  FROM ${ref("fact_registrations")}

),

/* -------------------------------------------------------------------------- */
/* COMMUNITY                                                                  */
/* -------------------------------------------------------------------------- */

community_identity AS (

  SELECT
    TO_HEX(
      SHA256(
        CONCAT(
          'community_registration|',
          CAST(id AS STRING)
        )
      )
    ) AS registration_id,

    CAST(id AS STRING) AS community_event_id,
    CAST(user_id AS STRING) AS community_user_id,

    NULLIF(
      LOWER(TRIM(email)),
      ''
    ) AS email

  FROM `hotspawn-440312.hotspawn_community_rudderstack.account_created`

  WHERE source = 'backend'
    AND event = 'account_created'
    AND (
      env = 'prod'
      OR env IS NULL
      OR TRIM(env) = ''
    )

),

community_enriched AS (

  SELECT
    c.registration_id,
    c.registration_date,
    c.registration_timestamp,
    c.registration_type,
    c.source_system,

    -- Historical Community source identity is not a valid GA4 pseudo ID.
    CAST(NULL AS STRING) AS valid_user_pseudo_id,

    i.email,
    i.community_user_id,
    i.community_event_id,

    CASE
      WHEN i.registration_id IS NOT NULL
        AND i.email IS NOT NULL
        THEN 'HISTORICAL_COMMUNITY_NON_GA4_ID'

      WHEN i.registration_id IS NOT NULL
        AND i.email IS NULL
        THEN 'COMMUNITY_EMAIL_NOT_FOUND'

      ELSE 'COMMUNITY_IDENTITY_NOT_FOUND'
    END AS identity_quality_status

  FROM canonical c

  LEFT JOIN community_identity i
    USING (registration_id)

  WHERE c.registration_type = 'community_registration'

),

/* -------------------------------------------------------------------------- */
/* PICK'EMS - RUDDERSTACK IDENTITY EVIDENCE                                   */
/* -------------------------------------------------------------------------- */

/*
For every RudderStack Identify record, preserve every GA4-style pseudo-ID
candidate present on the row.

We intentionally do NOT use COALESCE here because different identity fields
could theoretically contain different values. Each candidate is evaluated.
*/

pickems_identify_presence_raw AS (

  SELECT DISTINCT
    pseudo_id AS user_pseudo_id,
    i.timestamp AS identify_timestamp

  FROM `hotspawn-440312.website.identifies` i

  CROSS JOIN UNNEST(
    ARRAY(
      SELECT DISTINCT candidate
      FROM UNNEST([
        NULLIF(TRIM(i.context_traits_hs_ga4_pseudo_id), ''),
        NULLIF(TRIM(i.context_traits_ga4_pseudo_id), ''),
        NULLIF(TRIM(i.context_traits_user_pseudo_id), '')
      ]) AS candidate
      WHERE candidate IS NOT NULL
    )
  ) AS pseudo_id

  WHERE i._PARTITIONTIME >= TIMESTAMP('2026-06-01')

),

pickems_identify_presence AS (

  SELECT
    user_pseudo_id,
    COUNT(*) AS identify_rows

  FROM pickems_identify_presence_raw

  GROUP BY user_pseudo_id

),

/*
Email candidates are also kept independently instead of using COALESCE.
If context_traits_email and context_traits_user_email ever disagree, both
values are included and the identity will become ambiguous rather than one
email being selected arbitrarily.
*/

pickems_email_candidates_raw AS (

  SELECT DISTINCT
    pseudo_id AS user_pseudo_id,
    normalized_email AS email

  FROM `hotspawn-440312.website.identifies` i

  CROSS JOIN UNNEST(
    ARRAY(
      SELECT DISTINCT candidate
      FROM UNNEST([
        NULLIF(TRIM(i.context_traits_hs_ga4_pseudo_id), ''),
        NULLIF(TRIM(i.context_traits_ga4_pseudo_id), ''),
        NULLIF(TRIM(i.context_traits_user_pseudo_id), '')
      ]) AS candidate
      WHERE candidate IS NOT NULL
    )
  ) AS pseudo_id

  CROSS JOIN UNNEST(
    ARRAY(
      SELECT DISTINCT candidate_email
      FROM UNNEST([
        NULLIF(LOWER(TRIM(i.context_traits_email)), ''),
        NULLIF(LOWER(TRIM(i.context_traits_user_email)), '')
      ]) AS candidate_email
      WHERE candidate_email IS NOT NULL
    )
  ) AS normalized_email

  WHERE i._PARTITIONTIME >= TIMESTAMP('2026-06-01')

),

pickems_email_summary AS (

  SELECT
    user_pseudo_id,
    COUNT(DISTINCT email) AS distinct_email_count,

    CASE
      WHEN COUNT(DISTINCT email) = 1
        THEN ANY_VALUE(email)
      ELSE NULL
    END AS email

  FROM pickems_email_candidates_raw

  GROUP BY user_pseudo_id

),

pickems_identity AS (

  SELECT
    p.user_pseudo_id,
    p.identify_rows,

    COALESCE(e.distinct_email_count, 0)
      AS distinct_email_count,

    CASE
      WHEN COALESCE(e.distinct_email_count, 0) = 1
        THEN e.email
      ELSE NULL
    END AS email

  FROM pickems_identify_presence p

  LEFT JOIN pickems_email_summary e
    USING (user_pseudo_id)

),

pickems_enriched AS (

  SELECT
    c.registration_id,
    c.registration_date,
    c.registration_timestamp,
    c.registration_type,
    c.source_system,

    c.user_pseudo_id AS valid_user_pseudo_id,

    -- Email is exposed only when the pseudo ID resolves to exactly one email.
    CASE
      WHEN i.distinct_email_count = 1
        THEN i.email
      ELSE NULL
    END AS email,

    CAST(NULL AS STRING) AS community_user_id,
    CAST(NULL AS STRING) AS community_event_id,

    CASE
      WHEN c.user_pseudo_id IS NULL
        THEN 'NO_SUPPORTED_IDENTITY'

      WHEN i.user_pseudo_id IS NULL
        THEN 'PICKEMS_NO_IDENTIFY'

      WHEN i.distinct_email_count = 0
        THEN 'PICKEMS_IDENTIFY_NO_EMAIL'

      WHEN i.distinct_email_count = 1
        THEN 'PICKEMS_UNIQUE_EMAIL'

      ELSE 'PICKEMS_MULTIPLE_EMAILS'
    END AS identity_quality_status

  FROM canonical c

  LEFT JOIN pickems_identity i
    ON c.user_pseudo_id = i.user_pseudo_id

  WHERE c.registration_type = 'pickems_registration'

),

/* -------------------------------------------------------------------------- */
/* PERSONAL + NEWSLETTER                                                      */
/* -------------------------------------------------------------------------- */

/*
Email enrichment has not yet been approved for these registration types.

Keep their valid GA4 pseudo ID for identity diagnostics / anonymous identity,
but do NOT mark them ready for the registered-user email-keyed CIO flow.
*/

other_non_community AS (

  SELECT
    registration_id,
    registration_date,
    registration_timestamp,
    registration_type,
    source_system,

    user_pseudo_id AS valid_user_pseudo_id,

    CAST(NULL AS STRING) AS email,
    CAST(NULL AS STRING) AS community_user_id,
    CAST(NULL AS STRING) AS community_event_id,

    CASE
      WHEN user_pseudo_id IS NOT NULL
        THEN 'VALID_GA4_PSEUDO_ID'
      ELSE 'NO_SUPPORTED_IDENTITY'
    END AS identity_quality_status

  FROM canonical

  WHERE registration_type NOT IN (
    'community_registration',
    'pickems_registration'
  )

),

/* -------------------------------------------------------------------------- */
/* COMBINE                                                                    */
/* -------------------------------------------------------------------------- */

combined AS (

  SELECT * FROM community_enriched

  UNION ALL

  SELECT * FROM pickems_enriched

  UNION ALL

  SELECT * FROM other_non_community

)

/* -------------------------------------------------------------------------- */
/* FINAL ELIGIBILITY                                                          */
/* -------------------------------------------------------------------------- */

SELECT
  *,

  CASE
    WHEN email IS NOT NULL
      AND valid_user_pseudo_id IS NOT NULL
      THEN 'READY_BOTH'

    WHEN email IS NOT NULL
      THEN 'READY_EMAIL_ONLY'

    WHEN valid_user_pseudo_id IS NOT NULL
      THEN 'READY_PSEUDO_ONLY'

    ELSE 'NOT_READY'
  END AS cio_identity_state,

  /*
  IMPORTANT:
  This model represents the REGISTERED-USER Customer.io activation stream.

  Email is therefore required for activation readiness.

  Pseudo-only users remain valid canonical registrations and may participate
  in the separate anonymous Customer.io flow, but they are not eligible for
  this email-keyed registered-user upsert.
  */
  CASE
    WHEN email IS NOT NULL
      THEN TRUE
    ELSE FALSE
  END AS cio_activation_ready

FROM combined