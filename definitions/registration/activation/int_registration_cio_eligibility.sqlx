config {
  type: "view",
  tags: ["registration", "customerio", "activation"]
}

WITH canonical AS (

  SELECT *
  FROM ${ref("fact_registrations")}

),

community_identity AS (

  SELECT
    DATE(COALESCE(timestamp, original_timestamp, received_at)) AS registration_date,

    id AS community_event_id,
    CAST(user_id AS STRING) AS community_user_id,

    NULLIF(LOWER(TRIM(email)), '') AS email,

    -- Important:
    -- this is Community identity, NOT a valid GA4 pseudo ID
    user_pseudo_id AS community_source_user_pseudo_id,

    ROW_NUMBER() OVER (
      PARTITION BY DATE(COALESCE(timestamp, original_timestamp, received_at))
      ORDER BY COALESCE(timestamp, original_timestamp, received_at), id
    ) AS community_row_number

  FROM ${ref("account_created")}

  WHERE env = 'prod'
    AND source = 'backend'
    AND event = 'account_created'

),

community_canonical AS (

  SELECT
    c.*,

    ROW_NUMBER() OVER (
      PARTITION BY registration_date
      ORDER BY registration_id
    ) AS community_row_number

  FROM canonical c

  WHERE registration_type = 'community_registration'

),

community_enriched AS (

  SELECT
    c.registration_id,
    c.registration_date,
    c.registration_timestamp,
    c.registration_type,
    c.source_system,

    -- Historical Community GA4 identity remains unavailable
    CAST(NULL AS STRING) AS valid_user_pseudo_id,

    i.email,
    i.community_user_id,
    i.community_event_id,

    'HISTORICAL_COMMUNITY_NON_GA4_ID' AS identity_quality_status

  FROM community_canonical c

  LEFT JOIN community_identity i
    USING (
      registration_date,
      community_row_number
    )

),

non_community AS (

  SELECT
    registration_id,
    registration_date,
    registration_timestamp,
    registration_type,
    source_system,

    user_pseudo_id AS valid_user_pseudo_id,

    CAST(NULL AS STRING) AS email,
    CAST(NULL AS STRING) AS community_user_id,
    CAST(NULL AS STRING) AS community_event_id,

    CASE
      WHEN user_pseudo_id IS NOT NULL
        THEN 'VALID_GA4_PSEUDO_ID'
      ELSE 'NO_SUPPORTED_IDENTITY'
    END AS identity_quality_status

  FROM canonical

  WHERE registration_type != 'community_registration'

),

combined AS (

  SELECT * FROM community_enriched
  UNION ALL
  SELECT * FROM non_community

)

SELECT
  *,

  CASE
    WHEN email IS NOT NULL
      AND valid_user_pseudo_id IS NOT NULL
      THEN 'READY_BOTH'

    WHEN email IS NOT NULL
      THEN 'READY_EMAIL_ONLY'

    WHEN valid_user_pseudo_id IS NOT NULL
      THEN 'READY_PSEUDO_ONLY'

    ELSE 'NOT_READY'
  END AS cio_identity_state,

  CASE
    WHEN email IS NOT NULL
      OR valid_user_pseudo_id IS NOT NULL
      THEN TRUE
    ELSE FALSE
  END AS cio_activation_ready

FROM combined
