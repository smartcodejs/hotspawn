config {
  type: "view",
  tags: ["registration", "customerio", "activation", "community"]
}

WITH community_native AS (

  SELECT
    TO_HEX(
      SHA256(
        CONCAT(
          'community_registration|',
          CAST(id AS STRING)
        )
      )
    ) AS registration_id,

    LOWER(TRIM(email)) AS email,
    CAST(user_id AS STRING) AS community_user_id,
    handle AS community_handle,
    id AS community_event_id,
    timestamp AS community_registration_timestamp,
    DATE(timestamp) AS community_registration_date,
    source AS community_registration_source,
    event AS community_registration_event

  FROM ${ref("account_created")}

  WHERE source = 'backend'
    AND event = 'account_created'
    AND (
      env = 'prod'
      OR env IS NULL
      OR TRIM(env) = ''
    )
    AND NULLIF(TRIM(email), '') IS NOT NULL
),

canonical AS (

  SELECT
    registration_id

  FROM ${ref("fact_registrations")}

  WHERE registration_type = 'community_registration'
)

SELECT
  n.email,
  n.community_user_id,
  n.community_handle,
  'true' AS community_registered,
  n.community_registration_timestamp,
  n.community_registration_date,
  n.community_event_id,
  n.community_registration_source,
  n.community_registration_event,
  n.registration_id,

  -- Hotspawn / GA4 identity enrichment
  p.user_pseudo_id AS ga4_user_pseudo_id,
  p.identity_status AS hotspawn_identity_status,
  p.enrichment_status AS hotspawn_enrichment_status,

  p.hotspawn_identity_first_seen,
  p.hotspawn_identity_last_seen,

  -- Curated Hotspawn profile attributes
  p.acquisition_channel,
  p.acquisition_source,
  p.country,
  p.device_type,
  p.total_sessions,

  -- Known Hotspawn registration/subscription state
  p.personal_registered,
  p.pickems_registered,
  p.newsletter_subscribed

FROM canonical c

JOIN community_native n
  USING (registration_id)

LEFT JOIN ${ref("int_community_hotspawn_profile")} p
  ON n.email = p.email
