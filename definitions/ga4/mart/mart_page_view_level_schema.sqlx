config {
  type: "incremental",
  schema: dataform.projectConfig.vars.schema,
  tags: ["ga4","mart","pageviews","volume2"],
  bigquery: { partitionBy: "date", clusterBy: ["pseud_id","session_id"] },
  uniqueKey: ["session_id","pageview_number"]
}

SELECT
  -- standardized “mart” shape (matches your session mart’s naming)
  date,
  pseud_id,
  session_id,

  -- pageview fields
  page_url,
  page_title,
  theme_category,
  page_category,

  -- THE 3 COLUMNS you asked for
  author_name,
  max_scroll_percentage,
  max_time_on_page,

  -- navigation flags
  pageview_number,
  next_page_url,
  isLandingPage,
  isExitPage,
  exit_page_url,

  -- compatibility fields (kept for Looker/LS reports using old names)
  session_date,
  user_pseudo_id
FROM ${ref("int_pageviews")}
${when(incremental(), `
  WHERE date BETWEEN DATE_SUB(CURRENT_DATE('${dataform.projectConfig.vars.tz}'),
                              INTERVAL ${dataform.projectConfig.vars.lookback_days}-1 DAY)
                 AND CURRENT_DATE('${dataform.projectConfig.vars.tz}')
`)}
