config {
  type: "incremental",
  schema: dataform.projectConfig.vars.schema,
  tags: ["ga4", "mart", "ads"],
  bigquery: {
    partitionBy: "date",
    clusterBy: ["country", "device", "advertiser_name", "ad_placement"]
  },
  uniqueKey: [
    "date",
    "country",
    "device",
    "platform",
    "user_pseudo_id",
    "session_id",
    "page_url",
    "page_category",
    "theme_category",
    "ad_placement",
    "advertiser_name"
  ]
}

/*
  Final Ads mart.

  Behaviour:
  - Full (non-incremental) run: build everything available in int_ads_resolved
    (which is already limited to current year Jan 1 → today).
  - Incremental run: only re-build the last N days defined in
    projectConfig.vars.lookback_days and timezone vars.tz, same as pageviews.
*/

SELECT
  date,
  country,
  device,
  platform,
  user_pseudo_id,
  session_id,
  page_url,
  page_category,
  theme_category,
  ad_placement,
  advertiser_name,
  COUNTIF(event_name = 'banner_impression') AS impressions,
  COUNTIF(event_name = 'banner_click')      AS clicks
FROM ${ref("int_ads_resolved")}
WHERE 1 = 1
${when(incremental(), `
  AND date BETWEEN DATE_SUB(
                      CURRENT_DATE('${dataform.projectConfig.vars.tz}'),
                      INTERVAL ${dataform.projectConfig.vars.lookback_days}-1 DAY
                   )
                 AND CURRENT_DATE('${dataform.projectConfig.vars.tz}')
`)}
GROUP BY
  date, country, device, platform, user_pseudo_id, session_id,
  page_url, page_category, theme_category, ad_placement, advertiser_name