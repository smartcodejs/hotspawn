config {
  type: "incremental",
  schema: dataform.projectConfig.vars.schema,
  tags: ["ga4", "mart", "cta"],

  bigquery: {
    partitionBy: "date",
    clusterBy: ["user_pseudo_id", "session_id"]
  },

  uniqueKey: ["cta_interaction_key"],

  assertions: {
    uniqueKey: ["cta_interaction_key"],

    nonNull: [
      "cta_interaction_key",
      "date"
    ],

    rowConditions: [
      "impression IN (0, 1)",
      "click IN (0, 1)",
      "(impression = 1 OR click = 1)"
    ]
  }
}

WITH cta AS (

  SELECT
    event_date,
    user_pseudo_id,
    ga_session_id,
    batch_page_id,
    page_url,
    page_title,

    cta_name,
    cta_type,
    cta_location,
    destination_url,

    first_impression_ts,
    first_click_ts,

    impression,
    click

  FROM ${ref("int_cta_interactions")}

  WHERE 1 = 1

  ${when(incremental(), `
    AND event_date BETWEEN
      DATE_SUB(
        CURRENT_DATE('${dataform.projectConfig.vars.tz}'),
        INTERVAL ${dataform.projectConfig.vars.lookback_days}-1 DAY
      )
      AND CURRENT_DATE('${dataform.projectConfig.vars.tz}')
  `)}
),

cta_with_event_time AS (

  SELECT
    *,

    COALESCE(
      first_impression_ts,
      first_click_ts
    ) AS cta_event_time

  FROM cta
),

candidate_matches AS (

  SELECT
    cta.event_date,

    CONCAT(
      cta.user_pseudo_id,
      '-',
      CAST(cta.ga_session_id AS STRING)
    ) AS session_id,

    cta.user_pseudo_id,
    cta.batch_page_id,

    cta.page_url,
    cta.page_title,

    cta.cta_name,
    cta.cta_type,
    cta.cta_location,
    cta.destination_url,

    cta.first_impression_ts,
    cta.first_click_ts,

    cta.impression,
    cta.click,

    cta.cta_event_time,

    pv.pageview_number,
    pv.pageview_time,

    pv.page_title AS pv_page_title,
    pv.page_category AS pv_page_category,
    pv.theme_category AS pv_theme_category,

    ABS(
      TIMESTAMP_DIFF(
        cta.cta_event_time,
        pv.pageview_time,
        MILLISECOND
      )
    ) AS time_distance_ms

  FROM cta_with_event_time cta

  LEFT JOIN ${ref("int_pageviews")} pv
    ON cta.user_pseudo_id = pv.user_pseudo_id

    AND CONCAT(
      cta.user_pseudo_id,
      '-',
      CAST(cta.ga_session_id AS STRING)
    ) = pv.session_id

    AND cta.batch_page_id = pv.batch_page_id
),

best_match AS (

  SELECT *

  FROM candidate_matches

  QUALIFY ROW_NUMBER() OVER (

    PARTITION BY
      event_date,
      session_id,
      batch_page_id,
      page_url,
      cta_name,
      cta_type,
      cta_location,
      destination_url

    ORDER BY

      CASE
        WHEN pageview_number IS NOT NULL THEN 0
        ELSE 1
      END,

      time_distance_ms,

      pageview_number

  ) = 1
),

enriched AS (

  SELECT
    event_date,
    session_id,
    user_pseudo_id,
    batch_page_id,
    pageview_number,

    page_url,

    COALESCE(
      pv_page_title,
      page_title
    ) AS page_title,

    /*
      Page category

      Prefer the pageview taxonomy.

      If no pageview match exists, fall back
      to parsing the CTA page URL.
    */
    COALESCE(
      pv_page_category,

      COALESCE(
        NULLIF(
          REGEXP_EXTRACT(
            page_url,
            r'^https?://[^/]+/[^/?#]+/([^/?#]+)'
          ),
          ''
        ),
        'hotspawn'
      )
    ) AS page_category,

    /*
      Theme category

      Prefer the pageview taxonomy.

      If no pageview match exists, use the
      first URL path component.
    */
    COALESCE(
      pv_theme_category,

      COALESCE(
        NULLIF(
          REGEXP_EXTRACT(
            page_url,
            r'^https?://[^/]+/([^/?#]+)'
          ),
          ''
        ),
        'hotspawn'
      )
    ) AS theme_category,

    cta_name,

    /*
      CTA type

      Keep the tracked CTA type when present.

      Historical lander events did not populate
      cta_type, so classify the two known
      lander implementations from page_url.
    */
    CASE

      WHEN cta_type IS NOT NULL
        AND TRIM(cta_type) != ''
        THEN cta_type

      WHEN REGEXP_CONTAINS(
        LOWER(page_url),
        r'^https?://(www\.)?hotspawn\.com/landers/'
      )
        THEN 'lander'

      WHEN REGEXP_CONTAINS(
        LOWER(page_url),
        r'^https?://go\.hotspawn\.com/'
      )
        THEN 'lander'

      ELSE NULL

    END AS cta_type,

    /*
      Destination classification
    */
    COALESCE(
      NULLIF(
        REGEXP_EXTRACT(
          destination_url,
          r'^https?://[^/]+/([^/?#]+)'
        ),
        ''
      ),
      'external'
    ) AS cta_destination,

    destination_url,
    cta_location,

    first_impression_ts,
    first_click_ts,

    /*
      Reporting rule:

      A CTA click is also evidence that the CTA
      was exposed to the user.

      Raw GA4 remains unchanged.

      This mainly repairs historical lander rows
      where cta_click existed before
      cta_impression tracking was implemented.
    */
    GREATEST(
      COALESCE(impression, 0),
      COALESCE(click, 0)
    ) AS impression,

    COALESCE(
      click,
      0
    ) AS click

  FROM best_match
),

final AS (

  SELECT
    event_date AS date,

    /*
      Stable CTA interaction key.

      Note that cta_type is part of the key.
      Historical lander rows therefore require
      a controlled rebuild after this change.
    */
    TO_HEX(
      SHA256(
        TO_JSON_STRING(
          STRUCT(
            event_date AS event_date,
            session_id AS session_id,
            batch_page_id AS batch_page_id,
            page_url AS page_url,

            COALESCE(
              cta_name,
              ''
            ) AS cta_name,

            COALESCE(
              cta_type,
              ''
            ) AS cta_type,

            COALESCE(
              cta_location,
              ''
            ) AS cta_location,

            COALESCE(
              destination_url,
              ''
            ) AS destination_url
          )
        )
      )
    ) AS cta_interaction_key,

    session_id,
    user_pseudo_id,
    batch_page_id,
    pageview_number,

    page_url,
    page_title,
    page_category,
    theme_category,

    cta_name,
    cta_type,
    cta_destination,
    destination_url,
    cta_location,

    first_impression_ts,
    first_click_ts,

    impression,
    click

  FROM enriched
)

SELECT *
FROM final