config {
  type: "incremental",
  schema: dataform.projectConfig.vars.schema,
  tags: ["ga4", "mart", "crm"],
  bigquery: {
    partitionBy: "DATE(sent_datetime)",
    clusterBy: ["email_type", "campaign_name"]
  },
  uniqueKey: ["delivery_id"]
}

/*
  Final CRM performance mart.

  - Same columns as int_crm_performance_base (and your old static table).
  - Partitioned by DATE(sent_datetime).
  - Incremental: on incremental runs we only reload the last N days, using
    dataform.projectConfig.vars.lookback_days and vars.tz.
*/

SELECT
  delivery_id,
  email_client,
  country,
  email_type,
  campaign_name,
  email_name,
  subject_line,
  sent,
  sent_datetime,
  sent_reason,
  delivered,
  delivered_datetime,
  delivered_reason,
  opened,
  opened_datetime,
  opened_reason,
  clicked,
  clicked_datetime,
  clicked_reason,
  bounced,
  bounced_datetime,
  bounced_reason
FROM ${ref("int_crm_performance_base")}
WHERE 1 = 1
${when(incremental(), `
  AND DATE(sent_datetime) BETWEEN DATE_SUB(
        CURRENT_DATE('${dataform.projectConfig.vars.tz}'),
        INTERVAL ${dataform.projectConfig.vars.lookback_days}-1 DAY
      )
      AND CURRENT_DATE('${dataform.projectConfig.vars.tz}')
`)}
