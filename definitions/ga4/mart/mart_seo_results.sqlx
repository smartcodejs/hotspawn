config {
  type: "incremental",
  schema: dataform.projectConfig.vars.schema,
  tags: ["ga4", "mart", "seo"],
  bigquery: {
    partitionBy: "Date",
    clusterBy: ["Country", "Device", "Search_type"]
  },
  uniqueKey: [
    "Date",
    "Country",
    "Device",
    "Page_URL",
    "Theme_category",
    "Page_category",
    "Search_type"
  ]
}

/*
  Final SEO mart.

  Behaviour:
  - Full run: whole current year (because int_seo_agg_daily already filters Jan 1 → today).
  - Incremental run: only last lookback_days in vars (same pattern as pageviews).
*/

SELECT
  Date,
  Country,
  Device,
  Page_URL,
  Theme_category,
  Page_category,
  Search_type,
  Impressions,
  Clicks
FROM ${ref("int_seo_agg_daily")}
WHERE 1 = 1
${when(incremental(), `
  AND Date BETWEEN DATE_SUB(
                      CURRENT_DATE('${dataform.projectConfig.vars.tz}'),
                      INTERVAL ${dataform.projectConfig.vars.lookback_days}-1 DAY
                   )
                 AND CURRENT_DATE('${dataform.projectConfig.vars.tz}')
`)}
