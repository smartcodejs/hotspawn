config {
  type: "incremental",
  schema: dataform.projectConfig.vars.schema,
  tags: ["ga4","intermediate","pageviews"],
  bigquery: { partitionBy: "session_date", clusterBy: ["user_pseudo_id","session_id"] }
}

WITH base AS (
  SELECT
    session_date,
    user_pseudo_id,
    CONCAT(user_pseudo_id, '-', CAST(ga_session_id AS STRING)) AS session_id,
    event_ts,
    page_url,
    page_title,
    theme_category,
    page_category
  FROM ${ref("raw_page_source")}
  ${when(incremental(), `
    WHERE session_date BETWEEN DATE_SUB(CURRENT_DATE('${dataform.projectConfig.vars.tz}'),
                                        INTERVAL ${dataform.projectConfig.vars.lookback_days}-1 DAY)
                           AND CURRENT_DATE('${dataform.projectConfig.vars.tz}')
  `)}
),

windowed AS (
  SELECT
    b.*,
    ROW_NUMBER() OVER (PARTITION BY session_id ORDER BY event_ts)    AS pageview_number,
    LEAD(page_url) OVER (PARTITION BY session_id ORDER BY event_ts)  AS next_page_url,
    LEAD(event_ts)  OVER (PARTITION BY session_id ORDER BY event_ts) AS next_event_ts
  FROM base b
),

-- author from article_view
author_events AS (
  SELECT
    CONCAT(user_pseudo_id, '-', CAST(
      (SELECT ARRAY_AGG(ep.value.int_value IGNORE NULLS LIMIT 1)[OFFSET(0)]
         FROM UNNEST(event_params) ep WHERE ep.key='ga_session_id') AS STRING)
    ) AS session_id,
    (SELECT ARRAY_AGG(ep.value.string_value IGNORE NULLS LIMIT 1)[OFFSET(0)]
       FROM UNNEST(event_params) ep WHERE ep.key='page_location') AS page_url,
    TIMESTAMP_MICROS(event_timestamp) AS event_ts,
    COALESCE(
      NULLIF(
        (SELECT ARRAY_AGG(ep.value.string_value IGNORE NULLS LIMIT 1)[OFFSET(0)]
           FROM UNNEST(event_params) ep WHERE ep.key='author_name'),
        ''
      ),
      'hotspawn'
    ) AS author_name
  FROM `${dataform.projectConfig.defaultDatabase}.${dataform.projectConfig.vars.source_dataset}.events_*`
  WHERE event_name='article_view'
    ${when(incremental(), `
      AND _TABLE_SUFFIX BETWEEN
            FORMAT_DATE('%Y%m%d', DATE_SUB(CURRENT_DATE('${dataform.projectConfig.vars.tz}'),
                                           INTERVAL ${dataform.projectConfig.vars.lookback_days}-1 DAY))
        AND FORMAT_DATE('%Y%m%d', CURRENT_DATE('${dataform.projectConfig.vars.tz}'))
    `, `
      AND _TABLE_SUFFIX BETWEEN
            REPLACE("${dataform.projectConfig.vars.start_date}", "-", "")
        AND REPLACE("${dataform.projectConfig.vars.end_date}",   "-", "")
    `)}
),

-- scroll_depth -> max scroll % per (session_id, page_url)
scroll_events AS (
  SELECT
    CONCAT(user_pseudo_id, '-', CAST(
      (SELECT ARRAY_AGG(ep.value.int_value IGNORE NULLS LIMIT 1)[OFFSET(0)]
         FROM UNNEST(event_params) ep WHERE ep.key='ga_session_id') AS STRING)
    ) AS session_id,
    (SELECT ARRAY_AGG(ep.value.string_value IGNORE NULLS LIMIT 1)[OFFSET(0)]
       FROM UNNEST(event_params) ep WHERE ep.key='page_location') AS page_url,
    MAX(
      (SELECT ARRAY_AGG(ep.value.int_value IGNORE NULLS LIMIT 1)[OFFSET(0)]
         FROM UNNEST(event_params) ep WHERE ep.key='scroll_percentage')
    ) AS max_scroll_percentage
  FROM `${dataform.projectConfig.defaultDatabase}.${dataform.projectConfig.vars.source_dataset}.events_*`
  WHERE event_name='scroll_depth'
    ${when(incremental(), `
      AND _TABLE_SUFFIX BETWEEN
            FORMAT_DATE('%Y%m%d', DATE_SUB(CURRENT_DATE('${dataform.projectConfig.vars.tz}'),
                                           INTERVAL ${dataform.projectConfig.vars.lookback_days}-1 DAY))
        AND FORMAT_DATE('%Y%m%d', CURRENT_DATE('${dataform.projectConfig.vars.tz}'))
    `, `
      AND _TABLE_SUFFIX BETWEEN
            REPLACE("${dataform.projectConfig.vars.start_date}", "-", "")
        AND REPLACE("${dataform.projectConfig.vars.end_date}",   "-", "")
    `)}
  GROUP BY session_id, page_url
),

-- time_on_page -> max time per (session_id, page_url)
time_spent_data AS (
  SELECT
    CONCAT(user_pseudo_id, '-', CAST(
      (SELECT ARRAY_AGG(ep.value.int_value IGNORE NULLS LIMIT 1)[OFFSET(0)]
         FROM UNNEST(event_params) ep WHERE ep.key='ga_session_id') AS STRING)
    ) AS session_id,
    (SELECT ARRAY_AGG(ep.value.string_value IGNORE NULLS LIMIT 1)[OFFSET(0)]
       FROM UNNEST(event_params) ep WHERE ep.key='page_location') AS page_url,
    MAX(
      SAFE_CAST(
        REGEXP_EXTRACT(
          (SELECT ARRAY_AGG(ep.value.string_value IGNORE NULLS LIMIT 1)[OFFSET(0)]
             FROM UNNEST(event_params) ep WHERE ep.key='time_spent'),
          r'^(\d+)'
        ) AS INT64
      )
    ) AS max_time_on_page
  FROM `${dataform.projectConfig.defaultDatabase}.${dataform.projectConfig.vars.source_dataset}.events_*`
  WHERE event_name='time_on_page'
    ${when(incremental(), `
      AND _TABLE_SUFFIX BETWEEN
            FORMAT_DATE('%Y%m%d', DATE_SUB(CURRENT_DATE('${dataform.projectConfig.vars.tz}'),
                                           INTERVAL ${dataform.projectConfig.vars.lookback_days}-1 DAY))
        AND FORMAT_DATE('%Y%m%d', CURRENT_DATE('${dataform.projectConfig.vars.tz}'))
    `, `
      AND _TABLE_SUFFIX BETWEEN
            REPLACE("${dataform.projectConfig.vars.start_date}", "-", "")
        AND REPLACE("${dataform.projectConfig.vars.end_date}",   "-", "")
    `)}
  GROUP BY session_id, page_url
),

author_by_page AS (
  SELECT
    w.session_id, w.page_url, w.event_ts,
    ANY_VALUE(a.author_name) AS author_name
  FROM windowed w
  LEFT JOIN author_events a
    ON a.session_id = w.session_id
   AND a.page_url   = w.page_url
   AND a.event_ts  >= w.event_ts
   AND (w.next_event_ts IS NULL OR a.event_ts < w.next_event_ts)
  GROUP BY w.session_id, w.page_url, w.event_ts
),

next_pv AS (
  SELECT
    w.session_id, w.event_ts,
    ANY_VALUE(n.page_url) AS exit_page_url
  FROM windowed w
  LEFT JOIN windowed n
    ON n.session_id = w.session_id
   AND n.event_ts   = w.next_event_ts
  GROUP BY w.session_id, w.event_ts
)

SELECT
  w.session_date,
  w.user_pseudo_id,
  w.session_id,
  w.page_url,
  w.page_title,
  w.theme_category,
  w.page_category,
  COALESCE(abp.author_name, 'hotspawn') AS author_name,
  MAX(se.max_scroll_percentage)         AS max_scroll_percentage,
  MAX(ts.max_time_on_page)              AS max_time_on_page,
  w.pageview_number,
  w.next_page_url,
  IF(w.pageview_number = 1, 1, 0)       AS isLandingPage,
  IFNULL(IF(w.next_event_ts IS NULL, 1, 0), 0) AS isExitPage,
  ANY_VALUE(np.exit_page_url)           AS exit_page_url
FROM windowed w
LEFT JOIN scroll_events se
  ON se.session_id = w.session_id AND se.page_url = w.page_url
LEFT JOIN time_spent_data ts
  ON ts.session_id = w.session_id AND ts.page_url = w.page_url
LEFT JOIN author_by_page abp
  ON abp.session_id = w.session_id AND abp.page_url = w.page_url AND abp.event_ts = w.event_ts
LEFT JOIN next_pv np
  ON np.session_id = w.session_id AND np.event_ts = w.event_ts
GROUP BY
  w.session_date, w.user_pseudo_id, w.session_id, w.page_url, w.page_title,
  w.theme_category, w.page_category, abp.author_name,
  w.pageview_number, w.next_page_url, w.event_ts, w.next_event_ts
