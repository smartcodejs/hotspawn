config {
  type: "incremental",
  schema: dataform.projectConfig.vars.schema,
  name: "int_session_view",
  description: "One row per GA4 session (user_pseudo_id + ga_session_id) for Hotspawn. Same columns as analytics_457395054.session_view_level_schema_volume_3. Engagement, bounces, key events, excluded traffic and session date come from includes/metric_definitions.js; channel grouping from includes/channel_grouping.js. Sessions are no longer split at midnight: date = date of the session's first event.",

  uniqueKey: ["session_id"],

  bigquery: {
    partitionBy: "date",
    clusterBy: ["user_pseudo_id", "session_id"],
    // Limits the MERGE scan on the target to recent partitions.
    updatePartitionFilter: "date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)"
  },

  columns: {
    date: "Date of the session's first event (reporting timezone)",
    session_id: "user_pseudo_id + '-' + ga_session_id",
    engaged_session: "1 if >= 10 s engagement, OR >= 2 distinct pages viewed, OR a key event (metric_definitions.engagedSession)",
    bounces: "1 - engaged_session",
    channel_grouping: "Hotspawn channel grouping (includes/channel_grouping.js)"
  },

  assertions: {
    uniqueKey: ["session_id"],
    nonNull: ["date", "session_id", "user_pseudo_id", "engaged_session", "bounces", "channel_grouping"],
    rowConditions: [
      "engaged_session IN (0, 1)",
      "bounces IN (0, 1)",
      "engaged_session + bounces = 1",
      "page_view >= 1",
      // Channel checks carried over from the scheduled query's ASSERT block
      "NOT (REGEXP_CONTAINS(LOWER(COALESCE(session_campaign, '')), r'twca') AND channel_grouping != 'Paid Social')",
      "NOT (REGEXP_CONTAINS(LOWER(COALESCE(session_source, '')), r'reddit') AND LOWER(TRIM(COALESCE(session_medium, ''))) = 'cpc' AND channel_grouping != 'Paid Social')"
    ]
  },

  tags: ["sessions", "hotspawn", "daily"]
}

WITH events AS (
  SELECT
    event_timestamp,
    user_pseudo_id,
    event_name,

    (SELECT p.value.int_value    FROM UNNEST(event_params) p WHERE p.key = 'ga_session_id'        LIMIT 1) AS ga_session_id,
    (SELECT p.value.int_value    FROM UNNEST(event_params) p WHERE p.key = 'engagement_time_msec' LIMIT 1) AS engagement_time_msec,
    (SELECT p.value.string_value FROM UNNEST(event_params) p WHERE p.key = 'page_location'        LIMIT 1) AS page_location,
    (SELECT p.value.string_value FROM UNNEST(event_params) p WHERE p.key = 'auth_method'          LIMIT 1) AS auth_method,
    (SELECT p.value.string_value FROM UNNEST(event_params) p WHERE p.key = 'page_referrer'        LIMIT 1) AS page_referrer,

    IF(event_name = 'session_start', session_traffic_source_last_click.manual_campaign.source,        NULL) AS stslc_source,
    IF(event_name = 'session_start', session_traffic_source_last_click.manual_campaign.medium,        NULL) AS stslc_medium,
    IF(event_name = 'session_start', session_traffic_source_last_click.manual_campaign.campaign_name, NULL) AS stslc_campaign,
    session_traffic_source_last_click.cross_channel_campaign.default_channel_group                         AS ga4_default_channel_group,

    geo.country     AS geo_country,
    device.category AS device_category,
    platform

  FROM `hotspawn-440312.analytics_457395054.events_*`
  WHERE _TABLE_SUFFIX BETWEEN ${metric_definitions.eventsSuffixFrom(incremental())}
                          AND ${metric_definitions.eventsSuffixTo()}
),

events_clean AS (
  SELECT *
  FROM events
  WHERE user_pseudo_id IS NOT NULL
    AND ga_session_id IS NOT NULL
    AND NOT ${metric_definitions.isExcludedUrl("page_location")}
),

sessions AS (
  SELECT
    e.user_pseudo_id,
    e.ga_session_id,
    CONCAT(e.user_pseudo_id, '-', CAST(e.ga_session_id AS STRING)) AS session_id,

    ${metric_definitions.sessionDate("e.event_timestamp")} AS date,
    ${metric_definitions.sessionTime("e.event_timestamp")} AS session_time,

    MAX(e.geo_country)     AS country,
    MAX(e.device_category) AS device,
    MAX(e.platform)        AS platform,

    IF(COUNTIF(e.event_name = 'first_visit') > 0, 'New User', 'Returning User') AS user_type,

    MAX(e.stslc_source)              AS session_source,
    MAX(e.stslc_medium)              AS session_medium,
    MAX(e.stslc_campaign)            AS session_campaign,
    MAX(e.ga4_default_channel_group) AS ga4_default_channel_group,

    ${metric_definitions.engagedSession("e")} AS engaged_session,

    COUNTIF(e.event_name = 'page_view') AS page_view,

    MAX(IF(e.event_name IN ('user_signup', 'sign_up'), 1, 0)) AS user_signup,
    MAX(IF(e.event_name = 'newsletter_signup', 1, 0))         AS newsletter_signup,
    MAX(IF(e.event_name = 'user_login', 1, 0))                AS user_login,

    MAX(IF(e.event_name = 'user_login', e.auth_method, NULL)) AS login_auth_method,

    MAX(IF(e.event_name = 'user_login',
      CASE
        WHEN REGEXP_CONTAINS(LOWER(e.page_referrer), r'accounts\.google\.com') THEN 'Google'
        WHEN REGEXP_CONTAINS(LOWER(e.page_referrer), r'tw-auth')               THEN 'Thirdweb'
        WHEN e.auth_method = 'password'                                         THEN 'Email/Password'
        ELSE 'Other'
      END,
      NULL)) AS login_provider

  FROM events_clean e
  GROUP BY e.user_pseudo_id, e.ga_session_id
  -- Same as the scheduled query's inner join to sessions_with_pv:
  -- only sessions with at least one (non-excluded) page_view.
  HAVING COUNTIF(e.event_name = 'page_view') > 0
)

SELECT
  date,
  'Hotspawn' AS site_name,
  session_time,
  user_pseudo_id,
  session_id,
  country,
  device,
  platform,
  user_type,
  ${channel_grouping.sql("session_source", "session_medium", "session_campaign", "ga4_default_channel_group")} AS channel_grouping,
  session_source,
  session_medium,
  session_campaign,
  engaged_session,
  1 - engaged_session AS bounces,
  page_view,
  user_signup,
  newsletter_signup,
  user_login,
  login_auth_method,
  login_provider
FROM sessions
${when(incremental(), `WHERE date >= ${metric_definitions.refreshStart()}`)}